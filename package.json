{
  "name": "liuzu-cloud-tour",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:web": "pnpm --filter @liuzu/web dev",
    "dev:admin": "pnpm --filter @liuzu/admin dev",
    "build": "pnpm --filter @liuzu/web build && pnpm --filter @liuzu/admin build",
    "build:sites": "pnpm --filter @liuzu/web build && node scripts/prepare-sites-deploy.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:pages": "node scripts/build-pages.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.1",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.4",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "overrides": {
      "source-map-js": "1.2.2",
      "undici": "8.12.2",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12"
    }
  }
}
